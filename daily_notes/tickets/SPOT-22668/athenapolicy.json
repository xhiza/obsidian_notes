{
    "Statement": [
        {
            "Sid": "Statement1",
            "Effect": "Allow",
            "Action": [
                "athena:*",
                "glue:*"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "Statement2",
            "Effect": "Allow",
            "Resource": [
                "arn:aws:s3:::exasol-saas-customer-report-query-results/*",
                "arn:aws:s3:::exasol-saas-customer-report-query-results"
            ],
            "Action": [
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads",
                "s3:ListMultipartUploadParts",
                "s3:AbortMultipartUpload",
                "s3:PutObject"
            ]
        },
        {
            "Sid": "Statement3",
            "Effect": "Allow",
            "Resource": [
                "*"
            ],
            "Action": [
                "s3:ListAllMyBuckets"
            ]
        },
        {
            "Sid": "AthenaExamplesS3Access",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::aws-dev-cost-report*"
            ]
        }
    ]
}

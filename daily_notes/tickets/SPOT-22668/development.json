{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": "*",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": [
                        "eu-central-1",
                        "us-east-1",
                        "eu-west-1",
                        "eu-west-2",
                        "us-east-2",
                        "us-west-1",
                        "us-west-2"
                    ]
                }
            }
        },
        {
            "Effect": "Deny",
            "Action": "iam:CreateUser",
            "Resource": "*"
        }
    ]
}

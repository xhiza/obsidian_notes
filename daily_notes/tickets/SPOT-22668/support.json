{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Action": [
                "acm:ListCertificates"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "acm"
        },
        {
            "Action": [
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStacks",
                "cloudformation:GetStackPolicy",
                "cloudformation:GetTemplate",
                "cloudformation:GetTemplateSummary",
                "cloudformation:List*",
                "cloudformation:ValidateTemplate"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "cloudformation"
        },
        {
            "Action": [
                "cloudfront:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "cloudfront"
        },
        {
            "Action": [
                "cloudsearch:DescribeDomains"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "cloudsearch"
        },
        {
            "Action": [
                "cloudwatch:DescribeAlarms",
                "cloudwatch:Get*",
                "cloudwatch:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "cloudwatch"
        },
        {
            "Action": [
                "ec2:Describe*",
                "ec2:StartInstances",
                "ec2:StopInstances"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "ec2"
        },
        {
            "Action": [
                "elasticloadbalancing:DescribeInstanceHealth",
                "elasticloadbalancing:DescribeListeners",
                "elasticloadbalancing:DescribeLoadBalancers",
                "elasticloadbalancing:DescribeTargetGroups",
                "elasticloadbalancing:DescribeTargetHealth"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "elasticloadbalancing"
        },
        {
            "Action": [
                "lambda:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "lambda"
        },
        {
            "Action": [
                "route53:Get*",
                "route53:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "route53"
        },
        {
            "Action": [
                "route53domains:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "route53domains"
        },
        {
            "Action": [
                "route53resolver:Get*",
                "route53resolver:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "route53resolver"
        },
        {
            "Action": [
                "ssm:DescribeInstanceInformation",
                "ssm:GetCommandInvocation",
                "ssm:GetConnectionStatus",
                "ssm:ListDocuments",
                "ssm:SendCommand",
                "ssm:StartSession",
                "ssm:TerminateSession",
                "ssm:ListCommands",
                "ssm:ListCommandInvocations"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "ssm"
        },
        {
            "Action": [
                "support:*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "support"
        },
        {
            "Action": [
                "tag:GetResources",
                "tag:GetTagValues"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "tag"
        },
        {
            "Action": [
                "waf-regional:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "wafregional"
        },
        {
            "Action": [
                "waf:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "waf"
        },
        {
            "Action": [
                "wafv2:List*"
            ],
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "wafv2"
        },
        {
            "Effect": "Allow",
            "Action": [
                "ssm:DescribeParameters"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter"
            ],
            "Resource": [
                "arn:aws:ssm:eu-central-1:892065233093:parameter/*/exa_monitoring_user",
                "arn:aws:ssm:eu-central-1:929525451398:parameter/*/exa_monitoring_user",
                "arn:aws:ssm:eu-central-1:946287329088:parameter/*/exa_monitoring_user",
                "arn:aws:ssm:eu-central-1:978283744562:parameter/*/exa_monitoring_user"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "s3:ListAllMyBuckets"
            ],
            "Resource": "*"
        }
    ]
}{
